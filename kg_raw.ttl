@prefix : <http://example.org/nibrs/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/nibrs/ontology> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

:Incident a owl:Class ;
    rdfs:label "Incident" .

:Offense a owl:Class ;
    rdfs:label "Offense" .

:OffenseType a owl:Class ;
    rdfs:label "Offense type" ;
    rdfs:comment "A NIBRS offense category such as murder, robbery, or aggravated assault." .

:Victim a owl:Class ;
    rdfs:label "Victim" ;
    rdfs:comment "A victim associated with an incident and possibly with one or more offenses. In NIBRS, victims may be individuals, organizations, society/public, or other non-person entities." .

:Offender a owl:Class ;
    rdfs:label "Offender" ;
    rdfs:comment "An offender associated with an incident." .

:VictimType a owl:Class ;
    rdfs:label "Victim type" ;
    rdfs:comment "A NIBRS victim type, such as individual, business, government, or society." .

:VictimOffenderRelationship a owl:Class ;
    rdfs:label "Victim-offender relationship" ;
    rdfs:comment "A relationship record connecting a victim, an offender, and a NIBRS relationship type." .

:RelationshipType a owl:Class ;
    rdfs:label "Relationship type" ;
    rdfs:comment "A NIBRS relationship category describing how a victim is related to an offender." .


#################################################################
#    Data properties
#################################################################

:hasDate a owl:DatatypeProperty ;
    rdfs:label "has date" ;
    rdfs:domain :Incident ;
    rdfs:range xsd:dateTime .

:hasHour a owl:DatatypeProperty ;
    rdfs:label "has hour" ;
    rdfs:domain :Incident ;
    rdfs:range xsd:integer .

:offenseCode a owl:DatatypeProperty ;
    rdfs:label "offense code" ;
    rdfs:domain :OffenseType ;
    rdfs:range xsd:string ;
    rdfs:comment "The NIBRS offense code, for example 09A, 120, or 13A." .

:crimeAgainst a owl:DatatypeProperty ;
    rdfs:label "crime against" ;
    rdfs:domain :OffenseType ;
    rdfs:range xsd:string ;
    rdfs:comment "Descriptive NIBRS crime-against category, if available." .

:hasSex a owl:DatatypeProperty ;
    rdfs:label "has sex" ;
    rdfs:range xsd:string ;
    rdfs:comment "NIBRS sex code for a victim or offender." .

:hasAge a owl:DatatypeProperty ;
    rdfs:label "has age" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Age in years, if available and valid." .


#################################################################
#    Object properties
#################################################################

:hasIncident a owl:ObjectProperty ;
    rdfs:label "has incident" ;
    rdfs:comment "Links an offense to the incident in which it appears." ;
    rdfs:domain :Offense ;
    rdfs:range :Incident .

:victimInIncident a owl:ObjectProperty ;
    rdfs:label "victim in incident" ;
    rdfs:comment "Links a victim to the incident in which it appears." ;
    rdfs:domain :Victim ;
    rdfs:range :Incident .

:offenderInIncident a owl:ObjectProperty ;
    rdfs:label "offender in incident" ;
    rdfs:comment "Links an offender to the incident in which it appears." ;
    rdfs:domain :Offender ;
    rdfs:range :Incident .

:hasOffenseType a owl:ObjectProperty ;
    rdfs:label "has offense type" ;
    rdfs:comment "Links an offense to its offense type." ;
    rdfs:domain :Offense ;
    rdfs:range :OffenseType .

:hasVictimType a owl:ObjectProperty ;
    rdfs:label "has victim type" ;
    rdfs:comment "Links a victim to a NIBRS victim type." ;
    rdfs:domain :Victim ;
    rdfs:range :VictimType .

:involvedInOffense a owl:ObjectProperty ;
    rdfs:label "involved in offense" ;
    rdfs:comment "Links a victim to an offense in which the victim was involved." ;
    rdfs:domain :Victim ;
    rdfs:range :Offense .

:hasVictim a owl:ObjectProperty ;
    rdfs:label "has victim" ;
    rdfs:comment "Links a victim-offender relationship record to its victim." ;
    rdfs:domain :VictimOffenderRelationship ;
    rdfs:range :Victim .

:hasOffender a owl:ObjectProperty ;
    rdfs:label "has offender" ;
    rdfs:comment "Links a victim-offender relationship record to its offender." ;
    rdfs:domain :VictimOffenderRelationship ;
    rdfs:range :Offender .

:hasRelationshipType a owl:ObjectProperty ;
    rdfs:label "has relationship type" ;
    rdfs:comment "Links a victim-offender relationship record to a NIBRS relationship type." ;
    rdfs:domain :VictimOffenderRelationship ;
    rdfs:range :RelationshipType .

:relatedToOffender a owl:ObjectProperty ;
    rdfs:label "related to offender" ;
    rdfs:comment "Shortcut relation linking a victim directly to an offender. The detailed relationship type is represented through VictimOffenderRelationship." ;
    rdfs:domain :Victim ;
    rdfs:range :Offender .

#################################################################
#    Derived classes
#################################################################

:MultiOffenseIncident a owl:Class ;
    rdfs:subClassOf :Incident ;
    rdfs:label "Multi-offense incident" ;
    rdfs:comment "Derived class for incidents that have two or more associated offense records." .


#################################################################
#    Derived object properties
#################################################################

:coOffendedWith a owl:ObjectProperty ;
    rdfs:label "co-offended with" ;
    rdfs:comment "Derived relation between two offender records that are associated with the same incident." ;
    rdfs:domain :Offender ;
    rdfs:range :Offender .

:structurallySimilarTo a owl:ObjectProperty ;
    rdfs:label "structurally similar to" ;
    rdfs:comment "Derived relation between incidents that share the same offense type and victim-offender relationship type." ;
    rdfs:domain :Incident ;
    rdfs:range :Incident .
    
